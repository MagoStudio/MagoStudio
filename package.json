{
  "name": "mago-studio",
  "productName": "Mago Studio",
  "version": "0.20.2",
  "description": "Local-first desktop edition of Mago",
  "author": "Mago",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "desktop-dist/main/main.js",
  "engines": {
    "node": "^24.15.0",
    "npm": ">=11.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "dev": "node scripts/startDesktopDev.mjs",
    "dev:staging": "node scripts/startDesktopDev.mjs --staging",
    "dev:web": "next dev -p 3000",
    "build": "npm run build:web && npm run build:desktop",
    "build:web": "next build",
    "build:desktop": "tsc -p desktop/tsconfig.json && node scripts/copyCloudConfig.mjs",
    "package:desktop": "npm run build && electron-forge package",
    "make:desktop": "npm run build && electron-forge make",
    "analyze": "ANALYZE=true next build --webpack",
    "start": "electron-forge start",
    "lint": "oxlint -c .oxlintrc.json --react-plugin --nextjs-plugin --import-plugin --max-warnings 13 && node scripts/checkRawClipAccess.mjs && node scripts/checkLockfileIntegrity.mjs",
    "env:template": "node scripts/generateEnvTemplate.mjs",
    "env:template:check": "node scripts/generateEnvTemplate.mjs --check",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "type-check": "tsc --noEmit",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "build:storybook": "storybook build -o storybook-static",
    "format:stories": "oxfmt --write \".storybook/**/*.{ts,tsx,mdx}\" \"src/stories/**/*.{ts,tsx,mdx}\"",
    "format:stories:check": "oxfmt --check \".storybook/**/*.{ts,tsx,mdx}\" \"src/stories/**/*.{ts,tsx,mdx}\""
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.45.10",
    "@amplitude/plugin-session-replay-browser": "^1.35.1",
    "@chenglou/pretext": "^0.0.9",
    "@clerk/react": "^6.16.1",
    "@clerk/ui": "^1.33.1",
    "@floating-ui/react": "^0.27.20",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^5.9.1",
    "@react-types/shared": "3.36.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-table": "9.2.4",
    "@typeform/embed-react": "^5.0.0",
    "axios": "1.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "ffmpeg-static": "^5.3.0",
    "i18next": "^26.4.2",
    "jotai": "^3.0.0",
    "konva": "^10.5.0",
    "lodash": "^4.18.1",
    "mediabunny": "^1.58.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-ga4": "^3.0.1",
    "react-hook-form": "^7.88.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-product-fruits": "^2.3.0",
    "remark-breaks": "^4.0.0",
    "tailwind-merge": "^3.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@clerk/backend": "^3.18.1",
    "@clerk/testing": "^2.2.36",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@faker-js/faker": "^10.6.0",
    "@next/bundle-analyzer": "^16.3.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash": "^4.17.25",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-you-might-not-need-an-effect": "^1.0.1",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^30.1.0",
    "jsdom-testing-mocks": "^1.16.0",
    "knip": "^6.37.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "postcss": "^8.5.28",
    "postcss-load-config": "^6.0.1",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.28.2",
    "@esbuild/linux-x64": "^0.28.2",
    "@oxfmt/binding-linux-x64-gnu": "0.68.0",
    "@oxlint/binding-linux-x64-gnu": "^1.80.0",
    "@rollup/rollup-linux-x64-gnu": "4.63.4"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
